# Copy to .env.local (never committed). Both Supabase values are PUBLIC (the live site already sends
# them to every browser): the project URL and the *publishable* key. Never put a secret/service key here.
NEXT_PUBLIC_SUPABASE_URL=https://ctyyxxermexmcknhfmtl.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Where the existing treehouse server (anon-inbox/server.js) lives. Anything this app doesn't handle
# (/api/*, /terms, /privacy, avatars, the landing page...) is passed through to it.
LEGACY_ORIGIN=https://treehouse.ng

# 1 = preview with sample data and no database (uses dev/mock-supabase.js). Never set in production.
NEXT_PUBLIC_TH_MOCK=0

# Games (Kickrs). The defaults are the live Kickrs addresses; only set these for testing.
# NEXT_PUBLIC_KICKRS_ORIGIN=https://kickrs.app
# NEXT_PUBLIC_KICKRS_API=https://play.kickrs.app
# NEXT_PUBLIC_KICKRS_RETURN_URLS=
# Server only, SECRET: signs the one-minute Kickrs pass. Made by `node scripts/kickrs-keys.mjs`.
KICKRS_SIGNING_KEY=
# Preview only: lets the sample-data preview sign passes for fake members. Never set in production.
KICKRS_MOCK_TICKETS=0
